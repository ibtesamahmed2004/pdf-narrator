import pyttsx3

import PyPDF3

from tkinter.filedialog import *



book = askopenfilename()
pdfreader = PyPDF3.PdfFileReader(book)
pages = pdfreader.numPages

for num in range(0, pages):
    page = pdfreader.getPage(num)
    text = page.extractText()
    player = pyttsx3.init()
    player.say(text)
    player.runAndWait()
